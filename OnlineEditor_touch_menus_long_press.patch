diff --git a/frontend/webEditor/tests/menus.spec.ts b/frontend/webEditor/tests/menus.spec.ts
new file mode 100644
index 0000000..a90daa3
--- /dev/null
+++ b/frontend/webEditor/tests/menus.spec.ts
@@ -0,0 +1,71 @@
+import { expect, Page, test } from "@playwright/test";
+
+async function expectStacked(page: Page) {
+    const dock = page.locator(".responsive-menu-dock");
+    await expect(dock).toBeVisible();
+    await expect(dock.locator(":scope > .ui-float")).toHaveCount(6);
+    await expect
+        .poll(() =>
+            dock.locator(":scope > .ui-float").evaluateAll((menus) => {
+                const bounds = menus.map((menu) => menu.getBoundingClientRect());
+                return bounds.every(
+                    (box, index) =>
+                        box.left >= 0 &&
+                        box.right <= window.innerWidth &&
+                        (index === 0 || box.top >= bounds[index - 1].bottom + 8),
+                );
+            }),
+        )
+        .toBe(true);
+}
+
+test("phone menus stack on the right, remain separate when expanded, and preserve state on resize", async ({
+    page,
+}) => {
+    await page.setViewportSize({ width: 375, height: 667 });
+    await page.goto("/");
+    await expectStacked(page);
+    await page.locator(".help-ui .accordion-button").tap();
+    await expect(page.locator("#help-ui-checkbox")).toBeChecked();
+    await page.locator(".constraint-menu .accordion-button").tap();
+    await expect(page.locator("#constraint-menu-checkbox")).toBeChecked();
+    await expectStacked(page);
+    await page.locator("#run-button").scrollIntoViewIfNeeded();
+    await expect(page.locator("#run-button")).toBeInViewport();
+    await expect(page.locator("#repair-button")).toBeInViewport();
+    await page.setViewportSize({ width: 2000, height: 1000 });
+    await expect(page.locator(".responsive-menu-dock")).toBeHidden();
+    await expect(page.locator("#help-ui-checkbox")).toBeChecked();
+    await expect(page.locator("#constraint-menu-checkbox")).toBeChecked();
+    const help = await page.locator(".help-ui").boundingBox();
+    const constraints = await page.locator(".constraint-menu").boundingBox();
+    expect(help!.x + help!.width).toBeLessThan(constraints!.x);
+    await page.setViewportSize({ width: 375, height: 667 });
+    await expectStacked(page);
+});
+
+test("opening menus on a medium screen triggers docking when their measured widths collide", async ({ page }) => {
+    await page.setViewportSize({ width: 1000, height: 750 });
+    await page.goto("/");
+    await expect(page.locator(".help-ui")).toBeVisible();
+    await expect(page.locator(".responsive-menu-dock")).toBeHidden();
+    await page.locator(".help-ui .accordion-button").tap();
+    await page.locator(".constraint-menu .accordion-button").tap();
+    await expectStacked(page);
+});
+
+test("narrow landscape and 320px portrait keep all six menus reachable", async ({ page }) => {
+    await page.setViewportSize({ width: 600, height: 320 });
+    await page.goto("/");
+    await expectStacked(page);
+    await page.locator(".constraint-menu .accordion-button").scrollIntoViewIfNeeded();
+    await expect(page.locator(".constraint-menu .accordion-button")).toBeInViewport();
+    await page.setViewportSize({ width: 320, height: 568 });
+    await expectStacked(page);
+    await page.locator(".constraint-menu .accordion-button").tap();
+    await expectStacked(page);
+    await page.locator("#run-button").scrollIntoViewIfNeeded();
+    await expect(page.locator("#repair-button")).toBeInViewport();
+    await page.locator(".tool-palette").scrollIntoViewIfNeeded();
+    await expect(page.locator(".tool-palette")).toBeInViewport();
+});
diff --git a/frontend/webEditor/tests/touch.spec.ts b/frontend/webEditor/tests/touch.spec.ts
index ffd5d14..d13a98c 100644
--- a/frontend/webEditor/tests/touch.spec.ts
+++ b/frontend/webEditor/tests/touch.spec.ts
@@ -262,3 +262,55 @@ test("read-only pins and flows have no delete buttons", async ({ page }) => {
         .tap();
     await expect(page.locator(".flow-delete")).toHaveCount(0);
 });
+
+test("background long press opens Ctrl+Space palette without placing a node", async ({ page }) => {
+    await palette(page, 2).tap();
+    const session = await page.context().newCDPSession(page);
+    await session.send("Input.dispatchTouchEvent", { type: "touchStart", touchPoints: [{ x: 450, y: 180 }] });
+    await expect(page.locator(".command-palette input")).toBeVisible();
+    await session.send("Input.dispatchTouchEvent", { type: "touchEnd", touchPoints: [] });
+    await expect(nodes(page)).toHaveCount(7);
+    await expect(palette(page, 2)).not.toHaveClass(/active/);
+    await session.detach();
+});
+
+test("long press is cancelled by movement and does not open on nodes", async ({ page }) => {
+    const session = await page.context().newCDPSession(page);
+    const at = await center(node(page, "view").locator("text.sprotty-label"));
+    await session.send("Input.dispatchTouchEvent", { type: "touchStart", touchPoints: [at] });
+    await page.waitForTimeout(700);
+    await expect(page.locator(".command-palette input")).not.toBeVisible();
+    await session.send("Input.dispatchTouchEvent", { type: "touchEnd", touchPoints: [] });
+    await session.send("Input.dispatchTouchEvent", { type: "touchStart", touchPoints: [{ x: 450, y: 180 }] });
+    await session.send("Input.dispatchTouchEvent", { type: "touchMove", touchPoints: [{ x: 490, y: 200 }] });
+    await page.waitForTimeout(700);
+    await expect(page.locator(".command-palette input")).not.toBeVisible();
+    await session.send("Input.dispatchTouchEvent", { type: "touchEnd", touchPoints: [] });
+    await session.detach();
+});
+
+test("pinch zoom changes only the diagram and keeps floating menus fixed", async ({ page }) => {
+    const menus = page.locator(".ui-float");
+    const boxes = () =>
+        menus.evaluateAll((elements) =>
+            elements.map((e) => {
+                const { x, y, width, height } = e.getBoundingClientRect();
+                return { x, y, width, height };
+            }),
+        );
+    const before = await boxes();
+    const diagram = await transform(page);
+    await gesture(page, [
+        [
+            { x: 350, y: 150, id: 1 },
+            { x: 550, y: 150, id: 2 },
+        ],
+        [
+            { x: 300, y: 150, id: 1 },
+            { x: 600, y: 150, id: 2 },
+        ],
+    ]);
+    await expect.poll(() => transform(page)).not.toBe(diagram);
+    expect(await boxes()).toEqual(before);
+    expect(await page.evaluate(() => window.visualViewport?.scale)).toBe(1);
+});
